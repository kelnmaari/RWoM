    <Compile Remove="TMPCompat.cs" />
    <Compile Remove="TMPCompatStartup.cs" />
    <Compile Remove="BattleLogEntry_TMAbilityUsed.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

</Project>
