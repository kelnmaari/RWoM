      <HintPath>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3312959701\1.6\Assemblies\AbilityUser.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AbilityUserAI">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3312959701\1.6\Assemblies\AbilityUserAI.dll</HintPath>
