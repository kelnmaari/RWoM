    <Reference Include="CompDeflector">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3312959701\1.6\Assemblies\CompDeflector.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Soft dependency: HAR stub (ModCheck\AlienHumanoidRaces uses it directly) -->
    <Reference Include="AlienRace">
      <HintPath>D:\golang\RWoM\ext\HAR\1.6\Assemblies\AlienRace.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 1.7-only: Multiplayer compat layer (rwmt fork API) and 1.7 combat-log entry -->
