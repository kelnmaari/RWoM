<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Dedicated fuel resource; consumers are defined separately. -->
  <ThingDef ParentName="ResourceBase">
    <defName>TM_Magofuel</defName>
    <label>magofuel</label>
    <description>Chemfuel infused with magicyte in an arcane forge. A dense source of magical energy for equipment designed to use magofuel. It cannot replace chemfuel in ordinary equipment.</description>
    <graphicData>
      <texPath>Items/Magofuel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <stackLimit>150</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>4</MarketValue>
      <Mass>0.1</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <thingCategories><li>Manufactured</li></thingCategories>
  </ThingDef>

  <ResearchProjectDef>
    <defName>TM_MagofuelRefining</defName>
    <label>magofuel refining</label>
    <description>Learn to bind magicyte into chemfuel at an arcane forge, producing magofuel for dedicated magical equipment.</description>
    <baseCost>2000</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>TMagic</tab>
    <prerequisites>
      <li>TM_ArcaneForging</li>
      <li>BasicGravtech</li>
    </prerequisites>
    <researchViewX>4</researchViewX>
    <researchViewY>5</researchViewY>
  </ResearchProjectDef>

  <RecipeDef>
    <defName>TM_RefineMagofuel</defName>
    <label>refine magofuel x50</label>
    <description>Infuse 50 chemfuel with 200 magicyte to make 50 magofuel. Requires an arcane forge and its normal magical work and mana expenditure.</description>
    <jobString>refining magofuel.</jobString>
    <workSpeedStat>WorkSpeedGlobal</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>6000</workAmount>
    <workSkill>Intellectual</workSkill>
    <skillRequirements><Intellectual>4</Intellectual></skillRequirements>
    <researchPrerequisite>TM_MagofuelRefining</researchPrerequisite>
    <recipeUsers><li>TableArcaneForge</li></recipeUsers>
    <ingredients>
      <li><filter><thingDefs><li>Chemfuel</li></thingDefs></filter><count>50</count></li>
      <li><filter><thingDefs><li>RawMagicyte</li></thingDefs></filter><count>200</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Chemfuel</li><li>RawMagicyte</li></thingDefs></fixedIngredientFilter>
    <products><TM_Magofuel>50</TM_Magofuel></products>
  </RecipeDef>
</Defs>

